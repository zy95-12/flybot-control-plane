[Unit]
Description=FlyBot platform administrator upgrade coordinator
After=docker.service network-online.target flybot-platform-manager.service
Wants=network-online.target

[Service]
Type=simple
User=root
UMask=0077
ExecCondition=/usr/bin/systemctl is-active --quiet docker.service
ExecStart=/usr/bin/python3 /srv/flybot-platform-botawaken/manager/upgrade_runner.py
Restart=on-failure
RestartSec=15
# Finish or roll back the current bounded operation on graceful shutdown.
KillMode=process
TimeoutStopSec=900
CPUQuota=100%
MemoryMax=512M
TasksMax=160
Nice=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
