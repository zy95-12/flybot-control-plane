# FlyBot control plane — copy to .env and fill in. NEVER commit real values.
# --- control plane (panel) ---
APP_SECRET=CHANGE_ME_random_64_chars
DATABASE_URL=postgresql+psycopg://flybot:CHANGE_ME@postgres:5432/flybot
POSTGRES_PASSWORD=CHANGE_ME
PLATFORM_DOMAIN=example.com
COOKIE_SECURE=true
SESSION_TTL_HOURS=12
INVITE_TTL_HOURS=72
LOGIN_FAILURE_LIMIT=8
LOGIN_WINDOW_SECONDS=900
RUNTIME_MANAGEMENT_ENABLED=false
MAX_RUNTIME_INSTANCES=16
# --- compose images / mounted files ---
CONTROL_PLANE_IMAGE=flybot/control-plane:latest
FLYBOT_RUNTIME_IMAGE=flybot/runtime:latest
BOTSOCIAL_IMAGE=flybot/bot-social:latest
POSTGRES_IMAGE=postgres:16
TRAEFIK_IMAGE=traefik:v3
CLOUDFLARED_IMAGE=cloudflare/cloudflared:latest
INGRESS_STATIC_FILE=./deploy/sites/example/traefik-public.yml
INGRESS_DYNAMIC_DIR=./config/dynamic
INGRESS_ACME_DIR=./acme
RUNTIME_CA_CERT=/path/to/ca.crt
CANARY_TLS_CERT=/path/to/canary.crt
CANARY_TLS_KEY=/path/to/canary.key
SOCIAL_INGRESS_CERT=/path/to/social.crt
SOCIAL_INGRESS_KEY=/path/to/social.key
CLOUDFLARE_TOKEN_FILE=/path/to/cloudflare-tunnel-token
# --- host manager / worker ---
FLYBOT_HOST_PUBLIC_IP=203.0.113.10
FLYBOT_DNS_UPSTREAMS=1.1.1.1,8.8.8.8
GITHUB_TOKEN=
FLYBOT_GITHUB_TOKEN_FILE=/srv/flybot-platform-botawaken/secrets/github-api-token
