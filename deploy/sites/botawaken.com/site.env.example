# Overlay site-specific non-secret values on the base environment.
COMPOSE_PROJECT_NAME=flybot-platform-bowawaken
PLATFORM_DOMAIN=botawaken.com
PUBLIC_HTTPS_PORT=443
# Staging stays loopback-only and uses a separate port until container validation.
STAGING_HTTPS_PORT=18443
CONTROL_PLANE_BIND_ADDRESS=127.0.0.1
CONTROL_PLANE_PORT=18088
COOKIE_SECURE=true
